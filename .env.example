# --- LiveKit ---
LIVEKIT_URL=ws://127.0.0.1:17980
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Empty = automatic dispatch (dev). Set a name in production for explicit dispatch.
LIVEKIT_AGENT_NAME=

# --- Agent ---
# cascade = STT -> Gemini -> DarAI tools -> TTS (default)
# live = Gemini native audio | pipeline = STT -> router -> DarAI -> TTS
VOICE_MODE=cascade
# cascade and pipeline: openai | gemini
VOICE_PROVIDER=openai
GOOGLE_API_KEY=replace_me
OPENAI_API_KEY=replace_me
# Optional model overrides: ROUTER_MODEL, LIVE_MODEL, GEMINI_TTS_MODEL, GEMINI_VOICE,
# OPENAI_STT_MODEL, OPENAI_TTS_MODEL, OPENAI_VOICE

# --- Conversation turn management (cascade / pipeline) ---
VOICE_TURN_DETECTOR=v1-mini
VOICE_INTERRUPTION_MODE=vad
VOICE_MIN_ENDPOINT_DELAY=0.3
VOICE_MAX_ENDPOINT_DELAY=2.5
VOICE_SETTLE_DELAY=0.3
VOICE_NOTICE_DELAY=6
VOICE_AWAY_TIMEOUT=15
# Set both cloud credentials only when enabling adaptive interruption.
# Keep the self-hosted LiveKit transport credentials above unchanged.
LIVEKIT_INFERENCE_API_KEY=
LIVEKIT_INFERENCE_API_SECRET=

# --- DarAI knowledge channel ---
DARAI_BASE_URL=https://devdarai.prideidea.com
DARAI_API_KEY=replace_me

# --- Web / token API ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Exact public origin in production (https://voice.example.com)
WEB_ORIGIN=
TOKEN_TTL_MINUTES=10
TOKENS_PER_MINUTE=6
# Only behind a proxy that overwrites X-Forwarded-For
TRUST_PROXY=false

LOG_LEVEL=INFO
LOG_FORMAT=json
